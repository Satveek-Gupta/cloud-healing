# ════════════════════════════════════════════════
#   SelfHeal Backend — Environment Variables
#   Copy to .env and fill in values.
# ════════════════════════════════════════════════

# ── Server ───────────────────────────────────────
PORT=8000
NODE_ENV=production

# ── CORS ─────────────────────────────────────────
# Set to your deployed frontend URL in production
FRONTEND_URL=https://your-frontend.vercel.app

# ── Supabase ──────────────────────────────────────
# Get these from: https://supabase.com/dashboard → project → API settings
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Backend must use the service-role key because auth/audit tables deny direct client access.
SUPABASE_KEY=your-supabase-service-role-key

# ── Clerk Authentication ───────────────────────────────────────
CLERK_SECRET_KEY=sk_live_or_test_...
# Optional but recommended for networkless JWT verification.
# Paste Clerk Dashboard → API Keys → JWT public key → PEM Public Key.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUDIENCE=selfheal-api
CLERK_AUTHORIZED_PARTIES=https://your-frontend.vercel.app,http://localhost:3000

# ── Server-owned roles. Exactly one email for each privileged role. ──────────
SUPERADMIN_EMAIL=founder@example.com
ADMIN_EMAIL=ops-admin@example.com

# ── Strict browser origins ─────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ── AI Providers (at least one required for real healing) ─────────────────
# Google Gemini (recommended — faster, cheaper)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (fallback if Gemini is not set)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Set to true ONLY for local development without AI keys.
# Healing pipeline will use deterministic mock responses.
ALLOW_AI_MOCK=false
