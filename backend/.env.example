# ════════════════════════════════════════════════
#   SelfHeal Backend — Environment Variables
#   Copy to .env and fill in values.
# ════════════════════════════════════════════════

# ── Server ───────────────────────────────────────
PORT=8000
NODE_ENV=production

# ── CORS ─────────────────────────────────────────
# Set to your deployed frontend URL in production
FRONTEND_URL=https://your-frontend.vercel.app

# ── Supabase ──────────────────────────────────────
# Get these from: https://supabase.com/dashboard → project → API settings
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ── AI Providers (at least one required for real healing) ─────────────────
# Google Gemini (recommended — faster, cheaper)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (fallback if Gemini is not set)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Set to true ONLY for local development without AI keys.
# Healing pipeline will use deterministic mock responses.
ALLOW_AI_MOCK=false
