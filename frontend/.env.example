# ─────────────────────────────────────────────────────────────────────────
# SelfHeal Frontend — Environment Variables
# Copy this file to .env.local for local dev.
# Set all variables in your Vercel / hosting dashboard for production.
# ─────────────────────────────────────────────────────────────────────────

# ── Backend API ────────────────────────────────────────────────────────────
# Used for mutation calls (write, delete, commands) and initial data load.
# Local dev: http://localhost:8000
# Render/Railway: https://your-backend-url.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── Clerk Authentication ───────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_live_...
CLERK_SECRET_KEY=sk_test_or_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Clerk JWT template that emits aud=selfheal-api. Create this in Clerk Dashboard.
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=selfheal-api

# ── Supabase (required for Realtime live updates) ─────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
# These are safe to expose publicly — they use Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
